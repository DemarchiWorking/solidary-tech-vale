# Copie para terraform.tfvars (gitignorado). No CI, os sensíveis vêm de
# secrets do GitHub como TF_VAR_<nome>.
state_bucket = "<id-do-projeto>-tfstate"

# github_repository = "DemarchiWorking/solidary-tech-vale"
argocd_github_token      = "<token-fine-grained-so-leitura>"
datadog_api_key          = "<datadog-api-key>"
selfheal_service_account = "<ci-selfheal@id-do-projeto.iam.gserviceaccount.com>"
