# Copie para terraform.tfvars (gitignorado) e preencha com valores reais.
# Nunca commite terraform.tfvars com segredos de verdade.

subscription_id         = "<sua-subscription-id-azure>"
location                = "eastus"
project_name            = "solidarytech"
environment              = "prod"
postgres_admin_password = "<senha-forte>"

# Ligue quando estiver pronto pra provisionar bancos/mensageria/Velero
# (custa dinheiro real). Deixe `false` pra validar só cluster+observabilidade.
deploy_databases = false

# Dono dos repositórios fiap-tc-5-* no GitHub (serviços e GitOps)
github_owner = "<usuario-ou-organizacao-github>"

# Token fine-grained só de leitura (Contents: Read) no fiap-tc-5-gitops,
# para o ArgoCD ler o repositório privado. Deixe vazio se ele for público.
argocd_github_token = "<github-token-fine-grained-so-leitura>"

# Datadog (Organization Settings > API Keys / Application Keys)
datadog_api_key = "<...>"
datadog_app_key = "<...>"
datadog_site    = "datadoghq.com" # ou us5.datadoghq.com, etc.

# PagerDuty (User Settings > API Access Keys)
pagerduty_token      = "<...>"
pagerduty_user_email = "<seu-email-pagerduty>"

# Discord (Configurações do canal > Integrações > Webhooks)
discord_webhook_url = "https://discord.com/api/webhooks/<id>/<token>"

# GitHub PAT com escopo 'repo', usado pelo Datadog pra disparar o
# repository_dispatch de self-healing nos repositórios dos serviços
github_selfheal_token = "<...>"

# Cobertura de monitors/PagerDuty/self-healing. donation-service é
# obrigatório (SLO do desafio); descomente os demais se quiser cobertura
# completa.
monitored_services = [
  "donation-service",
  # "ngo-service",
  # "volunteer-service",
  # "notification-service",
]
